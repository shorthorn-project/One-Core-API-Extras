    ServicePackSourceFiles  = "Fichiers sources du correctif Windows Server 2003"
    SP_SHORT_TITLE          = "KB942288-v4"
    SP_TITLE                = "Correctif logiciel pour Windows Server 2003 (article KB942288-v4)"
    SP_TITLE_XP             = "Correctif logiciel pour Windows XP (article KB942288-v4)"
