    WUCUN_TS_JOBFILE        = "Értesítõ kritikus Windows-frissítésekrõl.job"
    BITS_DISPLAY_NAME       = "Háttérben futó intelligens átviteli szolgáltatás"
    BITS_DESCRIPTION        = \
"Fájlok átvitele a háttérben a kihasználatlan hálózati sávszélesség felhasználásával. Ha leállítja a szolgáltatást, a szolgáltatástól függõ funkciók (például a Windows Update vagy az MSN Explorer) nem fogják tudni automatikusan letölteni a programokat és egyéb információkat. Ha letiltja ezt a szolgáltatást, a tõle közvetlenül függõ, hibajavító mechanizmussal nem rendelkezõ szolgáltatások nem képesek a fájlok átvitelére az IE alkalmazáson keresztül abban az esetben, ha a BITS le van tiltva."
    BITS_CLASS_NAME         = "Háttérben futó intelligens átvitel 1.0 verziójú vezérlõosztálya"
    BITS_CLASS_1_5_NAME     = "Háttérben futó intelligens átvitel 1.5 verziójú vezérlõosztálya"
    BITS_CLASS_2_0_NAME     = "Háttérben futó intelligens átvitel 2.0 verziójú vezérlõosztálya"
    BITS_CLASS_2_5_NAME     = "Háttérben futó intelligens átvitel 2.5 verziójú vezérlõosztálya"
    LEGACY_BITS_CLASS_NAME  = "Háttérben futó intelligens átvitel örökölt vezérlõosztálya"
    AU_DESCRIPTION          = "A Windows-frissítések letöltését és telepítését teszi lehetõvé. Ha a szolgáltatás le van tiltva, a számítógép nem veheti igénybe a Windows Update webhely automatikus frissítési szolgáltatását."
    AU_DISPLAY_NAME         = "Automatikus frissítések"
    MSI_DISPLAY_NAME        = "Windows Installer"
    MSI_DESCRIPTION         = "Windows telepítõ csomagként (*.msi) rendelkezésre álló alkalmazások hozzáadása, módosítása és eltávolítása. Ha letiltja ezt a szolgáltatást, a tõle függõ szolgáltatások nem fognak elindulni."
    CancelEventType         = "Megszakítási jelentés"
    MainCancelIntroString   = "Köszönjük, hogy eljuttatta hozzánk kérését. Ha a ""Jelentés küldése"" gombra kattint, a rendszer elküldi a Microsoftnak a telepítés meghiúsulásával kapcsolatos adatokat"
    MainCancelDetailsLink   = "Tekintse meg, mit tartalmaz a telepítési jelentés."
