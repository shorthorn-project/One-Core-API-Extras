    WUCUN_TS_JOBFILE        = "Notificación de actualización crítica de Windows.job"
    BITS_DISPLAY_NAME       = "Servicio de transferencia inteligente en segundo plano"
    BITS_DESCRIPTION        = \
"Transfiere los archivos en segundo plano usando el ancho de banda de red inactivo. Si el servicio se detiene, algunas características como Windows Update y MSN Explorer no podrán descargar programas u otra información automáticamente. Si se deshabilita este servicio, los servicios que dependan explícitamente de él podrían no transferir los archivos correctamente si no disponen de un mecanismo de seguridad ante errores para transferir los archivos directamente a través de Internet Explorer en caso de que se hayan deshabilitado los Servicios de transferencia inteligente en segundo plano."
    BITS_CLASS_NAME         = "Clase de control de transferencia inteligente en segundo plano 1.0"
    BITS_CLASS_1_5_NAME     = "Clase de control de transferencia inteligente en segundo plano 1.5"
    BITS_CLASS_2_0_NAME     = "Clase de control de transferencia inteligente en segundo plano 2.0"
    BITS_CLASS_2_5_NAME     = "Clase de control de transferencia inteligente en segundo plano 2.5"
    LEGACY_BITS_CLASS_NAME  = "Clase heredada de control de transferencia inteligente en segundo plano"
    AU_DESCRIPTION          = "Habilita la descarga e instalación de actualizaciones de Windows. Si el servicio está deshabilitado, el equipo no podrá utilizar la característica Actualizaciones Automáticas o el sitio Web de Windows Update."
    AU_DISPLAY_NAME         = "Actualizaciones automáticas"
    MSI_DISPLAY_NAME        = "Windows Installer"
    MSI_DESCRIPTION         = "Adds, modifies, and removes applications provided as a Windows Installer (*.msi) package. If this service is disabled, any services that explicitly depend on it will fail to start."
    CancelEventType         = "Cancelar informe"
    MainCancelIntroString   = "Gracias por informar sobre la solicitud. Al hacer clic en el botón ""Enviar informe"", los datos sobre las causas de error en la instalación se enviarán a Microsoft."
    MainCancelDetailsLink   = "Ver lo que contiene este informe de instalador."
    MainCancelReportBtn     = "En&viar informe"
    DetailsCancelHeader     = "Contenido del informe"
    DetailsCancelBody       = \
"El envío de este informe nos ayudará a mejorar la experiencia del usuario. Los datos recopilados se procesarán estadísticamente para entender qué inició el error en la instalación. Esta información nos ayudará a reducir el número de errores de instalación causados al aplicar actualizaciones."
    MsSHARED = "Microsoft Shared"
    OLEDB = "Ole DB"
    ADO = "ado"
    MSADC = "msadc"
    DAO = "DAO"
    MSSOAPBIN = "MSSoap\Binaries"
    MSSOAPBINRES = "MSSoap\Binaries\Resources\3082"
    SHAREDACCESS_SERVICE_NAME = "Firewall de Windows/Conexión compartida a Internet (ICS)"
